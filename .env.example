# ============================================================
# CV Artha Falah Utama - environment variables
# Copy file ini menjadi `.env.local` untuk development,
# dan daftarkan variabel yang sama di Vercel > Project Settings > Environment Variables.
# ============================================================

# --- Site ---------------------------------------------------
# Dipakai untuk metadataBase, canonical URL, sitemap, dan Open Graph.
NEXT_PUBLIC_SITE_URL="https://arthalabs.id"

# --- Google Analytics (opsional) -----------------------------
# Kosongkan kalau belum ada. Script GA hanya di-inject kalau variabel ini terisi.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# --- Email (Resend) ------------------------------------------
# Buat API key di https://resend.com/api-keys
#
# PENTING: file ini IKUT TERSIMPAN DI REPOSITORY (lihat pengecualian
# `!.env.example` di .gitignore). Jangan pernah menulis API key asli di sini -
# isi hanya di `.env.local` (tidak ikut ter-commit) dan di Environment
# Variables milik Vercel.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Alamat pengirim WAJIB memakai domain yang sudah diverifikasi di Resend.
CONTACT_FROM_EMAIL="Website Artha Falah <website@arthalabs.id>"
# Tujuan notifikasi form kontak (boleh lebih dari satu, pisahkan dengan koma).
CONTACT_TO_EMAIL="arthafalahutama@gmail.com"

# --- Google Maps (opsional) ----------------------------------
# Ambil dari Google Maps > Share > Embed a map > salin nilai atribut src.
NEXT_PUBLIC_MAPS_EMBED_SRC="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d16278081.630689578!2d102.40425322906611!3d-5.080880444271725!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2d95bb00298e3e0f%3A0x4b9006f68c024804!2sCV%20Artha%20Falah%20Utama!5e0!3m2!1sid!2sid!4v1789794478170!5m2!1sid!2sid"